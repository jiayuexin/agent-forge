{
  "name": "@agentforge/root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@8.6.12",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "type-check": "pnpm -r run type-check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo:golden-path": "vitest run examples/golden-path/golden-path.test.ts",
    "demo:offline-capability": "node examples/golden-path/run-offline.mjs",
    "prepare": "husky",
    "publish:dry-run": "pnpm -r --filter './packages/*' exec -- npm pack --dry-run && pnpm -r --filter './packages/*' --filter '!@agentforge/core' --filter '!@agentforge/cli' publish --dry-run --no-git-checks --access public --registry https://registry.npmjs.org",
    "publish:pack": "pnpm -r --filter './packages/*' exec -- npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
